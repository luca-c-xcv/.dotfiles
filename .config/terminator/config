[global_config]
  dbus = False
  window_state = maximise
  borderless = True
  broadcast_default = off
  inactive_color_offset = 0.79012345679
  enabled_plugins = CustomCommandsMenu, InsertTermName, LaunchpadBugURLHandler, LaunchpadCodeURLHandler, APTURLHandler, SSHManagerPlugin
  suppress_multiple_term_dialog = True
[keybindings]
  split_horiz = <Primary><Alt>h
  split_vert = <Primary><Alt>v
  switch_to_tab_1 = <Alt>1
  switch_to_tab_2 = <Alt>2
  switch_to_tab_3 = <Alt>3
  switch_to_tab_4 = <Alt>4
  switch_to_tab_5 = <Alt>5
  switch_to_tab_6 = <Alt>6
  switch_to_tab_7 = <Alt>7
  switch_to_tab_8 = <Alt>8
  switch_to_tab_9 = <Alt>9
  switch_to_tab_10 = <Alt>0
[profiles]
  [[default]]
    audible_bell = True
    visible_bell = True
    icon_bell = False
    background_color = "#131618"
    background_darkness = 0.85
    background_type = transparent
    backspace_binding = automatic
    cursor_shape = underline
    cursor_fg_color = "#131618"
    cursor_bg_color = "#ffffff"
    font = SauceCodePro Nerd Font Propo 9
    foreground_color = "#ffffff"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_infinite = True
    exit_action = hold
    palette = "#000000:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
    use_theme_colors = True
